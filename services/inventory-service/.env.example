# Template das variaveis de ambiente do inventory-service.
# Copie para .env e preencha. O .env e ignorado pelo git; este .example e
# versionado para documentar o que o servico (e o CI) precisam.
#
# Usuario e senha do Postgres vem do .env da RAIZ (POSTGRES_USER / POSTGRES_PASSWORD).

# OBRIGATORIA. Banco proprio do servico (padrao banco-por-servico).
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/inventory_db

# OBRIGATORIA e SEM VALOR PADRAO de proposito: um placeholder conhecido em
# repositorio publico e um segredo publico. Gere com:
#   openssl rand -hex 32
JWT_SECRET=

# Opcional. Default 3004 se ausente (src/config/env.ts).
INVENTORY_PORT=3004
