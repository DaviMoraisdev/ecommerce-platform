{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Servico de pagamentos da plataforma e-commerce",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.dev.json src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate:test": "bash scripts/migrate-test-db.sh",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:fast",
    "test:fast": "jest --ci",
    "test:integration": "jest --ci --config jest.integration.config.ts",
    "verify": "npm run test && npm run build",
    "verify:integration": "npm run typecheck && npm run test:integration"
  },
  "author": "DaviMoraisdev",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
