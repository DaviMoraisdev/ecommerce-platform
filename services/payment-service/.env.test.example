PAYMENT_PORT=3007
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_test_db
DEFAULT_CURRENCY=BRL

# A suite de integracao executa deleteMany(). A guarda em tests/test-db-guard.ts
# so permite rodar contra o banco payment_test_db em host local.
#
# INTEGRATION_ALLOW_REMOTE=true desliga APENAS a checagem de host — o nome do
# banco continua obrigatorio. Nao habilite sem saber exatamente o que o alvo e.
# INTEGRATION_ALLOW_REMOTE=true

NODE_ENV=test
ALLOW_TEST_DB_RESET=true

# Exigido pela guarda em tests/helpers/testDbGuard.ts.
# ALLOW_TEST_DB_RESET=true e consentimento EXPLICITO para apagar este banco.
# ALLOW_REMOTE_TEST_DB desliga APENAS a checagem de host; o nome do banco
# continua obrigatorio. Nao habilite sem saber exatamente qual e o alvo.
# ALLOW_REMOTE_TEST_DB=true
