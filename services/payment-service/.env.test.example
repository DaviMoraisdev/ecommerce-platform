PAYMENT_PORT=3007
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_test_db
DEFAULT_CURRENCY=BRL
NODE_ENV=test

# Exigido pela guarda em tests/helpers/testDbGuard.ts.
# ALLOW_TEST_DB_RESET=true e consentimento EXPLICITO para apagar este banco.
ALLOW_TEST_DB_RESET=true

# ALLOW_REMOTE_TEST_DB desliga APENAS a checagem de host; nome do banco,
# NODE_ENV e o opt-in acima continuam obrigatorios. Nao habilite sem saber
# exatamente qual e o alvo.
# ALLOW_REMOTE_TEST_DB=true

# Provedor de pagamento: "fake" (dev/teste) ou "stripe" (Bloco 9).
# FAIL-CLOSED: "fake" e RECUSADO no boot fora de development/test, porque ele
# aprova cobranca sem mover dinheiro.
PAYMENT_PROVIDER=fake

# OBRIGATORIA e SEM VALOR PADRAO. Segredo do HMAC dos webhooks do provedor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# OBRIGATORIA e SEM VALOR PADRAO. Precisa ser o MESMO segredo do auth-service:
# este servico verifica os tokens que ele emite.
JWT_SECRET=
