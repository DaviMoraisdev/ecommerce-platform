# Porta HTTP do servico
PAYMENT_PORT=3007

# Banco proprio do payment-service (padrao banco-por-servico)
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_db

# Moeda padrao das cobrancas
DEFAULT_CURRENCY=BRL

# Provedor de pagamento: "fake" (dev/teste) ou "stripe" (Bloco 9).
# FAIL-CLOSED: "fake" e RECUSADO no boot fora de development/test, porque ele
# aprova cobranca sem mover dinheiro.
# OBRIGATORIO. Sem lista fechada e sem valor explicito, uma implantacao que
# copiasse este arquivo subiria com o provedor falso, aprovando pagamentos
# sem movimentar dinheiro. Valores aceitos: development, test, production.
NODE_ENV=development

PAYMENT_PROVIDER=fake

# OBRIGATORIA e SEM VALOR PADRAO. Segredo do HMAC dos webhooks do provedor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# OBRIGATORIA e SEM VALOR PADRAO. Precisa ser o MESMO segredo do auth-service:
# este servico verifica os tokens que ele emite.
JWT_SECRET=

# OBRIGATORIA e SEM FALLBACK. Base do order-service. Diferente do
# INVENTORY_SERVICE_URL do product, que cai em localhost quando ausente e por
# isso e divida registrada: um deploy sem a variavel apontaria para o proprio host.
ORDER_SERVICE_URL=http://localhost:3006

# Opcional. Teto de tempo por chamada ao order, em ms. Default 5000.
ORDER_SERVICE_TIMEOUT_MS=5000
# Opcional, default false. Declara que o transporte ate o order-service e
# protegido por mTLS ou malha de servico, permitindo http:// em producao.
#
# O Authorization do usuario e repassado naquela chamada: em texto claro, quem
# estiver na rede captura o token. Fora de producao a flag e irrelevante.
# ORDER_SERVICE_ALLOW_INSECURE=false


# Opcional. Janela de retentativa em minutos. Default 15.
# PROVISORIO: valor definitivo sai no Bloco 6, com o job de expiracao.
# Aumentar prende estoque por mais tempo; reduzir da menos tempo ao cliente
# para trocar de cartao.
PAYMENT_WINDOW_MINUTES=15

# OBRIGATORIA em production, opcional em development/test.
# Sem broker, a captura e gravada e o pedido nunca fica sabendo — por isso e
# fail-closed em producao, no mesmo criterio do PAYMENT_PROVIDER=fake.
# A CREDENCIAL VIAJA NA URL: em producao exige amqps://, salvo declaracao
# explicita de transporte protegido (mesma regra do ORDER_SERVICE_URL).
RABBITMQ_URL=amqp://usuario:senha@127.0.0.1:5672

# Opcional, default false. Permite amqp:// em producao quando o transporte ja
# e protegido por mTLS ou malha de servico.
# RABBITMQ_ALLOW_INSECURE=false

# Opcionais. Tuning do publisher, mesmos nomes e defaults do order-service.
# RABBITMQ_CONNECT_TIMEOUT_MS=5000
# RABBITMQ_PUBLISH_TIMEOUT_MS=3000
# RABBITMQ_MAX_RETRIES=5
# RABBITMQ_RETRY_DELAY_MS=2000
# RABBITMQ_CLOSE_TIMEOUT_MS=3000

# Opcionais. Tuning do relay da outbox.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH=20
# OUTBOX_STOP_TIMEOUT_MS=5000
