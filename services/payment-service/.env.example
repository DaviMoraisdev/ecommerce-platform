# Porta HTTP do servico
PAYMENT_PORT=3007

# Banco proprio do payment-service (padrao banco-por-servico)
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_db

# Moeda padrao das cobrancas
DEFAULT_CURRENCY=BRL

# Provedor de pagamento: "fake" (dev/teste) ou "stripe" (Bloco 9).
# FAIL-CLOSED: "fake" e RECUSADO no boot fora de development/test, porque ele
# aprova cobranca sem mover dinheiro.
PAYMENT_PROVIDER=fake

# OBRIGATORIA e SEM VALOR PADRAO. Segredo do HMAC dos webhooks do provedor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# OBRIGATORIA e SEM VALOR PADRAO. Precisa ser o MESMO segredo do auth-service:
# este servico verifica os tokens que ele emite.
JWT_SECRET=
