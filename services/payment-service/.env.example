# Porta HTTP do servico
PAYMENT_PORT=3007

# Banco proprio do payment-service (padrao banco-por-servico)
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_db

# Moeda padrao das cobrancas
DEFAULT_CURRENCY=BRL

# Provedor de pagamento: "fake" (dev/teste) ou "stripe" (Bloco 9).
# FAIL-CLOSED: "fake" e RECUSADO no boot fora de development/test, porque ele
# aprova cobranca sem mover dinheiro.
PAYMENT_PROVIDER=fake

# OBRIGATORIA e SEM VALOR PADRAO. Segredo do HMAC dos webhooks do provedor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# OBRIGATORIA e SEM VALOR PADRAO. Precisa ser o MESMO segredo do auth-service:
# este servico verifica os tokens que ele emite.
JWT_SECRET=

# OBRIGATORIA e SEM FALLBACK. Base do order-service. Diferente do
# INVENTORY_SERVICE_URL do product, que cai em localhost quando ausente e por
# isso e divida registrada: um deploy sem a variavel apontaria para o proprio host.
ORDER_SERVICE_URL=http://localhost:3006

# Opcional. Teto de tempo por chamada ao order, em ms. Default 5000.
ORDER_SERVICE_TIMEOUT_MS=5000

# Opcional. Janela de retentativa em minutos. Default 15.
# PROVISORIO: valor definitivo sai no Bloco 6, com o job de expiracao.
# Aumentar prende estoque por mais tempo; reduzir da menos tempo ao cliente
# para trocar de cartao.
PAYMENT_WINDOW_MINUTES=15
