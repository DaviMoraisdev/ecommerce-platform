# Porta HTTP do servico
PAYMENT_PORT=3007

# Banco proprio do payment-service (padrao banco-por-servico)
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/payment_db

# Moeda padrao das cobrancas
DEFAULT_CURRENCY=BRL

# Provedor de pagamento: "fake" (dev/teste) ou "stripe" (Bloco 9).
# FAIL-CLOSED: "fake" e RECUSADO no boot fora de development/test, porque ele
# aprova cobranca sem mover dinheiro.
# OBRIGATORIO. Sem lista fechada e sem valor explicito, uma implantacao que
# copiasse este arquivo subiria com o provedor falso, aprovando pagamentos
# sem movimentar dinheiro. Valores aceitos: development, test, production.
NODE_ENV=development

PAYMENT_PROVIDER=fake

# OBRIGATORIA e SEM VALOR PADRAO. Segredo do HMAC dos webhooks do provedor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# OBRIGATORIA e SEM VALOR PADRAO. Precisa ser o MESMO segredo do auth-service:
# este servico verifica os tokens que ele emite.
JWT_SECRET=

# OBRIGATORIA e SEM FALLBACK. Base do order-service. Diferente do
# INVENTORY_SERVICE_URL do product, que cai em localhost quando ausente e por
# isso e divida registrada: um deploy sem a variavel apontaria para o proprio host.
ORDER_SERVICE_URL=http://localhost:3006

# Opcional. Teto de tempo por chamada ao order, em ms. Default 5000.
ORDER_SERVICE_TIMEOUT_MS=5000
# Opcional, default false. Declara que o transporte ate o order-service e
# protegido por mTLS ou malha de servico, permitindo http:// em producao.
#
# O Authorization do usuario e repassado naquela chamada: em texto claro, quem
# estiver na rede captura o token. Fora de producao a flag e irrelevante.
# ORDER_SERVICE_ALLOW_INSECURE=false


# Opcional. Janela de retentativa em minutos. Default 15.
# PROVISORIO: valor definitivo sai no Bloco 6, com o job de expiracao.
# Aumentar prende estoque por mais tempo; reduzir da menos tempo ao cliente
# para trocar de cartao.
PAYMENT_WINDOW_MINUTES=15

# --- Inbox de webhook: quando PARAR de tentar (Bloco 6c) ---
# Os dois abaixo decidem quando o servico DESISTE de aplicar um evento
# financeiro. Quarentena e TERMINAL: sair dela e acao humana.

# Teto de tentativas que falharam com excecao. Ao atingi-lo, o evento vai para
# QUARANTINED e a rota responde 200, encerrando a reentrega do provedor.
# Faixa 1..100.
WEBHOOK_MAX_ATTEMPTS=5

# Idade a partir da qual um evento AINDA inaplicavel vai para QUARANTINED.
# Atende a populacao que o teto NAO alcanca: o desfecho retentavel devolve 5xx
# sem incrementar o contador. Faixa 1..10080 (7 dias).
#
# INVARIANTE VALIDADO NO BOOT: tem de ser MAIOR que PAYMENT_WINDOW_MINUTES mais
# o intervalo do job (RECONCILIACAO_POLL_INTERVAL_MS, em minutos arredondados
# para cima). Quem destrava essa populacao e a reconciliacao, e ela so age
# depois da janela E no proximo ciclo — quarentenar antes descarta um evento
# que seria resolvido.
#
# ATUALIZADO no Bloco 6e. A folga inclui tambem a DURACAO MAXIMA DE UM CICLO:
# JOBS_VARREDURA_TIMEOUT_MS vezes o numero de varreduras (VARREDURAS_POR_CICLO,
# hoje 3 — reconciliacao, inbox e expiracao). O proximo ciclo so e agendado
# quando TODAS terminam, e cada uma pode consumir o prazo inteiro.
#
# Acrescentar varredura APERTA este limite: um valor que passava no boot pode
# passar a ser recusado. A correcao e aumentar a quarentena, nunca afrouxar a
# formula — abaixo dela, eventos que seriam resolvidos sao descartados.
WEBHOOK_QUARANTINE_MINUTES=60

# Liga a varredura de EXPIRACAO da janela (Bloco 6e).
#
# Ela cancela no provedor a cobranca que passou da janela, leva o pagamento a
# EXPIRED e publica payment.expired. A pre-condicao de CODIGO foi cumprida no
# Bloco 6f (binding, consumidor e compensacao no order-service).
#
# Continua DESLIGADA no exemplo, de proposito (achado 4.4 do review do PR #61):
# os dois servicos nao sao implantados atomicamente. Um exemplo com `true`
# ligaria o produtor em ambiente onde o binding pode ainda nao existir, e o
# publisher usa mandatory + basic.return — evento nao roteavel.
#
# RUNBOOK DE ATIVACAO, nesta ordem:
#   1. inventariar pagamentos EXPIRED existentes; se houver, decidir backfill
#      (o produtor so cobre transicoes NOVAS);
#   2. implantar o order-service (consumidor + binding) e VALIDAR a topologia;
#   3. implantar o payment-service com a flag ainda desligada;
#   4. so entao ligar a flag.
#
# FAIL-CLOSED: ausencia ou qualquer valor diferente de `true` mantem desligada.
# Permanece como KILL-SWITCH: o job age sobre dinheiro no provedor.
PAYMENT_EXPIRATION_ENABLED=false

# Rota de REEMBOLSO (POST /payments/:id/refunds). Desligada por padrao.
#
# Com a flag off a rota NAO e registrada: 404, e nao 503. Com ela desligada a
# funcionalidade nao existe, e 503 prometeria que ela volta sozinha.
#
# HISTORICO: esta flag foi REMOVIDA ao fim do Bloco 7b e RESTAURADA na 3a
# rodada de review do PR #63. O motivo original — "o reembolso nao emite
# payment.refunded" — foi CUMPRIDO pelo 7b: o evento e publicado dentro da
# transacao do efeito e o order-service o consome. O motivo atual e outro.
#
# POR QUE CONTINUA DESLIGADA — dois debitos que protegem DINHEIRO:
#   1. NAO ha recuperacao quando o provedor confirma o estorno e o commit local
#      falha. O CASO R21 demonstra: provider.refund executa, a colisao de
#      eventId derruba a transacao, e nao sobra refundedAmountCents, linha
#      REFUND nem evento. O servico responde erro e continua afirmando
#      localmente que nada foi estornado. A reconciliacao que fecha isso esta no
#      TECH_DEBT, Fase 10, secao Jobs / reconciliacao.
#   2. O order-service NAO guarda a associacao autoritativa pagamento->pedido:
#      um payment.refunded dirigido a OUTRO pedido de mesmo total e aceito.
#      Exige coluna e migracao, e esta na Fase 7 junto da autenticacao
#      servico-a-servico.
#
# RUNBOOK DE ATIVACAO, nesta ordem:
#   1. entregar a reconciliacao de reembolso (debito 1 acima);
#   2. entregar a associacao autoritativa pagamento->pedido (debito 2);
#   3. cumprir as PRECONDICOES DE IMPLANTACAO abaixo;
#   4. implantar o order-service (consumidor + binding) e VALIDAR a topologia;
#   5. implantar o payment-service com a flag ainda desligada;
#   6. so entao ligar a flag — e remove-la em seguida. Esta flag tem data de
#      morte, diferente do kill-switch da expiracao.
#
# PRECONDICOES DE IMPLANTACAO (2a rodada de review, achados 4.2 e 5.3):
#   - a migration do indice unico parcial de estorno assume que NENHUMA linha
#     REFUND/SUCCEEDED historica compartilha providerRef. Antes do Bloco 7 o
#     webhook gravava ali a referencia da COBRANCA, entao dois estornos
#     parciais da mesma cobranca colidiriam. Hoje nao ha dado: o payment-service
#     nao esta no docker-compose e nao tem Dockerfile, entao nao existe frota
#     nem historico. Se algum dia existir, a ordem e: implantar o escritor novo
#     -> retirar os escritores antigos -> tratar historico -> criar o indice.
#   - rodar a suite de CONTRATO (payment-provider.contract.ts) contra o
#     adaptador real ANTES de ligar a flag: um adaptador que ainda lance
#     ProviderInvalidRequestError em vez de RefundExceedsAvailableError
#     transforma excesso de saldo em erro tecnico.
#
# FAIL-CLOSED: ausencia ou qualquer valor diferente de `true` mantem desligada.
PAYMENT_REFUND_ENABLED=false

# OBRIGATORIA em production, opcional em development/test.
# Sem broker, a captura e gravada e o pedido nunca fica sabendo — por isso e
# fail-closed em producao, no mesmo criterio do PAYMENT_PROVIDER=fake.
# A CREDENCIAL VIAJA NA URL: em producao exige amqps://, salvo declaracao
# explicita de transporte protegido (mesma regra do ORDER_SERVICE_URL).
RABBITMQ_URL=amqp://usuario:senha@127.0.0.1:5672

# Opcional, default false. Permite amqp:// em producao quando o transporte ja
# e protegido por mTLS ou malha de servico.
# RABBITMQ_ALLOW_INSECURE=false

# Opcionais. Tuning do publisher, mesmos nomes e defaults do order-service.
# RABBITMQ_CONNECT_TIMEOUT_MS=5000
# RABBITMQ_PUBLISH_TIMEOUT_MS=3000
# RABBITMQ_MAX_RETRIES=5
# RABBITMQ_RETRY_DELAY_MS=2000
# RABBITMQ_CLOSE_TIMEOUT_MS=3000

# Opcionais. Tuning do relay da outbox.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH=20
# OUTBOX_STOP_TIMEOUT_MS=5000

# --- Varreduras de manutencao: reconciliacao + inbox, UM timer para as duas ---
# RECONCILIACAO_POLL_INTERVAL_MS participa do invariante da quarentena acima.
# JOBS_VARREDURA_TIMEOUT_MS e o prazo de UMA varredura: sem ele, uma que nunca
# resolve seguraria o ciclo e pararia as demais.
# RECONCILIACAO_POLL_INTERVAL_MS=60000
# RECONCILIACAO_STOP_TIMEOUT_MS=5000
# JOBS_VARREDURA_TIMEOUT_MS=120000
