# Template das variaveis de ambiente do product-service.
# Copie para .env e preencha. O .env e ignorado pelo git; este .example e
# versionado para documentar o que o servico (e o CI) precisam.
#
# Usuario e senha do Mongo e do Redis vem do .env da RAIZ
# (MONGO_USER / MONGO_PASSWORD, REDIS_PASSWORD).

# OBRIGATORIA. Banco proprio do servico. Sem ela o boot falha.
MONGO_URI=mongodb://usuario:senha@127.0.0.1:27017/product_db?authSource=admin

# OBRIGATORIA e SEM VALOR PADRAO de proposito: um placeholder conhecido em
# repositorio publico e um segredo publico. Gere com:
#   openssl rand -hex 32
JWT_SECRET=

# Opcional. Default 3003 (src/server.ts).
PRODUCT_PORT=3003

# Opcional. Default redis://127.0.0.1:6379 (src/config/redis.ts).
# Note o usuario VAZIO antes dos dois pontos: e a forma da URL do Redis.
REDIS_URL=redis://:senha@127.0.0.1:6379

# Opcional. Default http://localhost:3004 (src/services/inventory.client.ts).
# DIVIDA REGISTRADA (Fase 7): o fallback para localhost nao deveria sobreviver a
# producao — a ausencia desta variavel deveria falhar no boot. Ver docs/TECH_DEBT.md.
INVENTORY_SERVICE_URL=http://localhost:3004
