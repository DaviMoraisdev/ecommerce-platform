generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Order {
  id             String               @id @default(uuid())
  userId         String
  idempotencyKey String?
  status         OrderStatus          @default(PENDENTE)
  total          Decimal              @db.Decimal(12, 2)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  // Constraints CHECK via migration: quantity > 0, unitPrice >= 0,
  // subtotal >= 0 (aqui) e total >= 0 (em orders).
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id String @id @default(uuid())

  // Sequencia monotonica: desempata transicoes gravadas no mesmo milissegundo.
  // createdAt e TIMESTAMP(3); ordenar so por ele deixa empates em ordem indefinida.
  seq Int @unique @default(autoincrement())

  orderId String

  // Cascade e DELIBERADO: a aplicacao NUNCA faz hard delete de pedido —
  // cancelar e transicao de status. Hard delete so ocorre em purga
  // administrativa, onde remover a trilha junto e intencional.
  // Politica coberta por teste de integracao.
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus
  toStatus   OrderStatus
  changedBy  String
  createdAt  DateTime    @default(now())

  // CHECK via migration: fromStatus <> toStatus.
  @@index([orderId])
  @@map("order_status_history")
}

model PendingCompensation {
  id         String    @id @default(uuid())
  orderId    String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
  @@map("pending_compensations")
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyRecord {
  id        String            @id @default(uuid())
  userId    String
  key       String
  orderId   String
  status    IdempotencyStatus @default(PROCESSING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, key])
  @@index([status])
  @@map("idempotency_records")
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model OutboxEvent {
  id         String       @id @default(uuid())
  // eventId que viaja no proprio evento — unico: correlaciona e permite o
  // consumidor deduplicar (idempotencia do 8b-2).
  eventId    String       @unique
  routingKey String
  payload    Json
  status     OutboxStatus @default(PENDING)
  attempts   Int          @default(0)
  lastError  String?
  createdAt  DateTime     @default(now())
  sentAt     DateTime?

  // Polling do relay: PENDING mais antigos primeiro.
  @@index([status, createdAt])
  @@map("outbox_events")
}

model InboxEvent {
  id String @id @default(uuid())
  // eventId que veio DENTRO do evento (determinstico do lado do payment:
  // "payment.captured:<paymentId>"). UNIQUE e a trava de duplicata: a garantia
  // vem da constraint, nao de um SELECT previo — checar-e-depois-inserir tem
  // corrida entre a checagem e o insert.
  eventId String @unique
  routingKey String
  // Quando o efeito commitou. Como o insert vive na MESMA transacao do efeito,
  // esta linha existir prova que o efeito aconteceu — e o contrario tambem.
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("inbox_events")
}
