ORDER_PORT=3006
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/order_test_db
# OBRIGATORIA e SEM VALOR PADRAO de proposito: um placeholder conhecido em
# repositorio publico e um segredo publico. Gere com:
#   openssl rand -hex 32
JWT_SECRET=
NODE_ENV=test
# Opt-in explicito: sem isto, os testes de integracao abortam.
ALLOW_TEST_DB_RESET=true

# Exigido pela guarda em tests/helpers/testDbGuard.ts.
# ALLOW_TEST_DB_RESET=true e consentimento EXPLICITO para apagar este banco.
# ALLOW_REMOTE_TEST_DB desliga APENAS a checagem de host; o nome do banco
# continua obrigatorio. Nao habilite sem saber exatamente qual e o alvo.
# ALLOW_REMOTE_TEST_DB=true
